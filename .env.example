# GitHub public data uses Pushkar's account by default; override only if needed.
VITE_GITHUB_USERNAME=pushkarchokar-coder

# WAKATIME_API_KEY belongs in GitHub Actions secrets only, not this Vite env file.

# Optional public profile URL (shown in the WakaTime card).
VITE_WAKATIME_PROFILE_URL=https://wakatime.com/@d0f584eb-2062-4787-8ac9-23df24e725c3

# Optional. LinkedIn stays hidden until your actual profile URL is set.
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_X_URL=
