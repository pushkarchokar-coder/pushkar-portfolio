# GitHub public data uses Pushkar's account by default; override only if needed.
VITE_GITHUB_USERNAME=pushkarchokar-coder

# Add this server-side secret in your deploy provider settings. Never use VITE_ here.
WAKATIME_API_KEY=your_wakatime_secret_key

# Optional: your public profile URL (shown as the WakaTime profile link).
VITE_WAKATIME_PROFILE_URL=https://wakatime.com
